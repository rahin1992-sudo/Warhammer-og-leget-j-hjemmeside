# Kopier denne fil til ".env" og udfyld dine egne værdier.
# (Filen ".env" bliver IKKE committet - den indeholder hemmeligheder.)

# Hvor skal færdige sål-ordrer (STL + video) sendes hen?
ORDER_EMAIL_TO=rahin1992@gmail.com

# Afsender-adresse der vises i mailen
ORDER_EMAIL_FROM=indlaegssaal-app@example.com

# ---------------------------------------------------------------------------
# SMTP-opsætning til at sende mails.
# Nemmeste løsning: en Gmail-konto + et "App Password".
#   1. Slå 2-trinsbekræftelse til på din Google-konto.
#   2. Gå til https://myaccount.google.com/apppasswords og lav et app-password.
#   3. Brug din gmail som SMTP_USER og app-passwordet som SMTP_PASS nedenfor.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=din-gmail@gmail.com
SMTP_PASS=dit-16-cifrede-app-password

# Port som serveren kører på
PORT=3000
